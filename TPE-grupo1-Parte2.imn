node n1 {
    type router
    model PC
    network-config {
	hostname CasaJefe
	!
	interface eth0
	 ip address 192.168.10.2/24
	!
    }
    canvas c1
    iconcoords {898.0 40.0}
    labelcoords {896.0 84.0}
    interface-peer {eth0 n3}
    services {DefaultRoute UserDefined}
    custom-config {
	custom-config-id service:UserDefined
	custom-command UserDefined
	config {
	cmdup=('ip addr add 192.168.10.2/24 dev eth0', )
	}
    }
}

node n2 {
    type router
    model router
    network-config {
	hostname RB
	!
	interface eth0
	 ip address 192.168.10.1/24
	!
	interface eth1
	 ip address 201.0.1.2/24
	!
    }
    canvas c1
    iconcoords {692.0 40.0}
    labelcoords {706.0 23.0}
    interface-peer {eth0 n3}
    interface-peer {eth1 n4}
    services {IPForward UserDefined}
    custom-config {
	custom-config-id service:UserDefined
	custom-command UserDefined
	config {
	cmdup=('ip addr add 192.168.10.1/24 dev eth0', 'ip addr add 201.0.1.2/24 dev eth1', 'ip route add default via 201.0.1.1 dev eth1', 'iptables -t nat -A POSTROUTING -o eth1 -j MASQUERADE', )
	}
    }
}

node n3 {
    type wlan
    network-config {
	hostname wlan3
	!
	interface wireless
	 ip address 10.0.0.0/32
	!
	mobmodel
	coreapi
	basic_range
	!
    }
    custom-config {
	custom-config-id basic_range
	custom-command {3 3 9 9 9}
	config {
	range=275
	bandwidth=54000000
	jitter=0
	delay=20000
	error=0
	}
    }
    canvas c1
    iconcoords {746.0 108.0}
    labelcoords {746.0 140.0}
    interface-peer {e0 n2}
    interface-peer {e1 n1}
}

